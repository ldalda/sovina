# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe (modo test inicial)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# WhatsApp via Evolution API (Pro tier)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=sovina

# URL pública (usado em links de callback e webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo de lançamento: 'waitlist' bloqueia /app, /login e /auth e mostra só a
# captura de e-mails na landing. Vazio (ou qualquer outro valor) = app normal.
LAUNCH_MODE=

# Resend — broadcasts da newsletter "Vereditos" para a waitlist (pós-captura)
RESEND_API_KEY=

# Automação de posts no Threads (ver docs/launch/THREADS-AUTOMACAO.md)
# Replies a terceiros exigem o token com o escopo threads_keyword_search.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Protege os endpoints /api/threads/* (mesmo valor no secret do GitHub)
CRON_SECRET=

# WhatsApp Cloud API — aprovação dos replies do Threads (ver docs/launch/THREADS-REPLIES.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token inventado por você; o mesmo é colado na config do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Seu número com DDI, só dígitos (ex: 5511999999999)
WHATSAPP_ADMIN_PHONE=
