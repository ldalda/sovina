# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Stripe (modo test inicial)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# WhatsApp via Evolution API (Pro tier)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=sovina

# URL pública (usado em links de callback e webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo de lançamento: 'waitlist' bloqueia /app, /login e /auth e mostra só a
# captura de e-mails na landing. Vazio (ou qualquer outro valor) = app normal.
LAUNCH_MODE=

# Resend — broadcasts da newsletter "Vereditos" para a waitlist (pós-captura)
RESEND_API_KEY=

# Automação de posts no Threads (ver docs/launch/THREADS-AUTOMACAO.md)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# Protege o endpoint /api/threads/publish (mesmo valor no secret do GitHub)
CRON_SECRET=
